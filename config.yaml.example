# Local address and port the proxy listens on
listen_host: "0.0.0.0"
listen_port: 8080

# providers: multi-provider routing configuration.
# Each provider has an identifier. Clients must prefix their real API key
# with the identifier in brackets, e.g.:
#   Authorization: Bearer [glm]your-real-zhipu-key
# The proxy uses the identifier to select the provider, strips the prefix,
# and forwards the real key to the provider's upstream_url.
providers:
  - identifier: "glm"
    upstream_url: "https://open.bigmodel.cn/api/anthropic"
    models:
      # Exact mappings still work as before and are advertised in /v1/models.
      claude-haiku-4-5: "glm-4.5-air"
      claude-sonnet-4-6: "glm-5"
      claude-opus-4-7: "glm-5.1"
      # Regex patterns (auto-anchored to the whole model ID) can cover dated
      # variants. Use real Python regex syntax: "claude-haiku.*" matches
      # claude-haiku-4-5-20251001, etc. Patterns are not advertised in
      # /v1/models and exact entries take priority over patterns.
      claude-haiku.*: "glm-4.5-air"

# MCP reverse proxy: intercepts HTTP requests from MCP servers (e.g. @z_ai/mcp-server)
# and injects authentication headers before forwarding to the real API.
# Set Z_AI_BASE_URL=http://<listen_host>:<listen_port>/mcp in the MCP server's env.
# Uncomment and configure the block below to enable.
# mcp:
#   upstream_url: "https://open.bigmodel.cn/api/paas/v4"
#   api_key: "your-zhipu-api-key-here"

# Optional HTTP client tuning for the model/MCP/image upstream clients.
# These values mirror the original hardcoded defaults; raise them if you need
# higher concurrency and the host has enough file descriptors / memory.
# proxy:
#   pool_timeout: 5.0
#   keepalive_expiry: 5.0
#   max_connections: 200
#   max_keepalive_connections: 50

# CCH public status page wrapper.
# When enabled, llm-proxy serves:
#   GET /cch/status
#   GET /cch/status/weekly-consumption
#   GET /cch/status/weekly-user-consumption?apiKey=<user-api-key>
# Each quota_groups entry is one weekly USD cap, drawn on its own status card.
# status_slug is the card (/status/<slug>). provider_group is the CCH provider
# tag whose weekly spend, request count, and token count are shown on that card.
# Omit provider_group when it matches status_slug.
# card_provider_groups is only for a card that has no quota_groups entry and
# whose name differs from its provider tag.
# cch_status:
#   enabled: false
#   base_url: "http://your-cch-host:22803"
#   admin_token: "your-cch-auth-token"
#   locale: "zh-CN"
#   timezone: "Asia/Shanghai"
#   cache_ttl_seconds: 300
#   # Local snapshot of the public status models' base prices. The status page
#   # reads this database; a background task refreshes it from CCH on the
#   # interval below. Omit the block to leave the price panel unavailable.
#   # Create the database and role first:
#   #   CREATE USER llm_proxy WITH PASSWORD '...';
#   #   CREATE DATABASE llm_proxy OWNER llm_proxy;
#   model_prices:
#     database_url: "postgresql://llm_proxy:password@127.0.0.1:5432/llm_proxy"
#     update_interval_seconds: 21600
#   # Enables the cached weekly user usage data used by:
#   #   /cch/status/weekly-leaderboard
#   #   /cch/status/weekly-user-consumption?apiKey=<user-api-key>
#   weekly_leaderboard_enabled: false
#   # Optional. Only for a card with no quota_groups entry whose name differs
#   # from its provider tag. Quota cards already use provider_group.
#   # card_provider_groups:
#   #   sonnet: ["claude"]
#   quota_groups:
#     - status_slug: opus
#       provider_group: claude
#       weekly_quota_usd: 500
#       auto_manage: false
#       disable_at_pct: 100
#     - status_slug: glm
#       weekly_quota_usd: 80
#       auto_manage: true
#       disable_at_pct: 90
#   # Real-provider coding-plan usage (Kimi / GLM / MiniMax only).
#   # Queries 5h + weekly utilization from the vendor API (not CCH), displays
#   # badges on status cards mapped via card_provider_groups, and
#   # disables/enables CCH providers in provider_group at 100% / reset.
#   # base_url is optional: defaults are
#   #   kimi    -> https://api.kimi.com/coding
#   #   glm     -> https://open.bigmodel.cn
#   #   minimax -> https://api.minimaxi.com
#   # Override base_url only for regional variants (api.z.ai, api.minimax.io, …).
#   # For kimi the base_url must include the /coding prefix; it is appended if missing.
#   # At most one monitor per provider_group. Use api_key for a single key
#   # (manages every CCH provider in the group). Use api_keys to bind each key
#   # to named CCH providers; enable/disable follows that key's quota, while the
#   # status page shows the weighted-mean 5h and weekly utilization across keys.
#   # Optional per-key weight (default 1.0) scales that key's contribution.
#   # Multi-key monitors require a non-empty providers list on every key.
#   usage_monitors:
#     - provider_group: claude
#       provider: glm
#       api_key: "your-glm-coding-plan-key"
#     # - provider_group: claude
#     #   provider: glm
#     #   api_keys:
#     #     - api_key: "glm-key-a"
#     #       providers: ["glm-prod-1", "glm-prod-2"]
#     #       weight: 2.0
#     #     - api_key: "glm-key-b"
#     #       providers: ["glm-prod-3"]
#     #       weight: 1.0
#     - provider_group: minimax
#       provider: minimax
#       api_key: "your-minimax-key"
#     - provider_group: kimi
#       provider: kimi
#       api_key: "your-kimi-key"
#   usage_query:
#     base_interval_seconds: 300        # poll when usage < 90%
#     min_interval_seconds: 30          # poll at 100%
#     high_usage_threshold_pct: 90
#     disable_threshold_pct: 100
#     request_timeout_seconds: 15
#     state_path: "data/cch_usage_state.json"

